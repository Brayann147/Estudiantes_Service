# ---------------------------------------------------------------
# Módulo Estudiantes - variables de entorno
# Copia este archivo a ".env" y ajusta los valores:
#   Linux/macOS:  cp .env.example .env
#   Windows CMD:  copy .env.example .env
# NUNCA subas el archivo .env al repositorio.
# ---------------------------------------------------------------

# --- Aplicación ---
NODE_ENV=development
PORT=3001
# error | warn | info | debug | silent
LOG_LEVEL=info
# Orígenes permitidos por CORS, separados por coma. "*" = cualquiera (solo desarrollo)
CORS_ORIGIN=*

# --- PostgreSQL (base de datos INDEPENDIENTE de este módulo) ---
# DB_PORT es el puerto publicado en tu máquina (host). Dentro de Docker siempre es 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=estudiantes_user
DB_PASSWORD=cambia_esta_clave
DB_NAME=estudiantes_db
# Base usada solo por Jest (se crea automáticamente al correr las pruebas)
DB_NAME_TEST=estudiantes_db_test
DB_POOL_MAX=10

# --- Almacenamiento de objetos (fotografías) ---
# Local: RustFS (docker compose up -d), compatible con S3.
# Nube (AWS): quita S3_ENDPOINT, S3_PUBLIC_ENDPOINT, S3_FORCE_PATH_STYLE y las claves AWS_*:
# el SDK toma las credenciales del rol de la tarea (ECS). El bucket debe ser PRIVADO.
S3_BUCKET=estudiantes-fotos
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Segundos de validez de las URLs firmadas de las fotos (60 a 86400)
PHOTO_URL_TTL_SECONDS=600
# Credenciales SOLO del S3 local (RustFS); también son el usuario/clave de su consola en :9001
AWS_ACCESS_KEY_ID=s3_local
AWS_SECRET_ACCESS_KEY=cambia_esta_clave_s3_local
